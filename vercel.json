{
  "version": 2,
  "builds": [
    { "src": "api/create-checkout.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "desktop.html", "use": "@vercel/static" },
    { "src": "tienda.html", "use": "@vercel/static" },
    { "src": "nfc.html", "use": "@vercel/static" },
    { "src": "static/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/create-checkout", "dest": "/api/create-checkout.js" },
    { "src": "/tienda", "dest": "/tienda.html" },
    { "src": "/nfc", "dest": "/nfc.html" },
    { "src": "/desktop", "dest": "/desktop.html" },
    { "src": "/desktop.html", "dest": "/desktop.html" },
    { "src": "/tienda.html", "dest": "/tienda.html" },
    { "src": "/nfc.html", "dest": "/nfc.html" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
